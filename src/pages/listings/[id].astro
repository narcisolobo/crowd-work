---
import Base from "../../layouts/Base.astro";
import TicketStub from "../../components/listings/TicketStub.astro";
import {
  getListingById,
  getExceptionsForListings,
  toRecurrenceListing,
} from "../../lib/data/listings";
import { resolveOccurrences } from "../../lib/utils/recurrence";
import { getTodayInLA, addDaysToDateStr } from "../../lib/utils/date";
import { formatStubDate, formatTime } from "../../lib/utils/format";

const { id } = Astro.params;

if (!id) {
  return Astro.redirect("/404");
}

const listing = await getListingById(id);

if (!listing) {
  return Astro.redirect("/404");
}

const exceptionsByListing = await getExceptionsForListings([listing.id]);
const exceptions = exceptionsByListing.get(listing.id) ?? [];

const todayInLA = getTodayInLA();
// Wider than the browse page's 30-day window: this page needs whatever the
// next occurrence actually is, so a monthly "last Thursday" listing doesn't
// falsely read as unscheduled just because it falls outside a tight range.
const lookaheadEnd = addDaysToDateStr(todayInLA, 90);
const soonEnd = addDaysToDateStr(todayInLA, 7);

const [occurrence] = resolveOccurrences(
  toRecurrenceListing(listing),
  exceptions,
  todayInLA,
  lookaheadEnd,
);

const isSoon = occurrence ? occurrence.date <= soonEnd : false;
const changeNote = occurrence?.note ?? null;

const stub = occurrence ? formatStubDate(occurrence.date) : null;
const timeLabel = occurrence ? formatTime(occurrence.startTime) : null;

const label = "font-body text-[0.65rem] font-semibold tracking-wider text-ink-soft uppercase";
---

<Base title={`${listing.title} — Crowd Work`}>
  <a
    href="/"
    class="mt-6 inline-flex items-center gap-1.5 text-[0.86rem] text-ink-soft underline-offset-2 hover:underline"
  >
    <svg
      class="h-2.5 w-2.5 rotate-90"
      viewBox="0 0 12 12"
      fill="none"
      aria-hidden="true"
    >
      <path
        d="M3 4.5L6 7.5L9 4.5"
        stroke="currentColor"
        stroke-width="1.3"
        stroke-linecap="round"
        stroke-linejoin="round"
      />
    </svg>
    Back to listings
  </a>

  <div class="hero mt-6 flex items-start gap-5 sm:gap-6">
    {
      stub ? (
        <TicketStub
          day={stub.day}
          date={stub.date}
          month={stub.month}
          isSoon={isSoon}
          size="large"
        />
      ) : (
        <div class="flex flex-none flex-col items-center justify-center gap-0.5 rounded-sm border-l-4 border-l-red bg-paper-shadow px-2 py-3 text-center">
          <span class="font-body text-[0.72rem] font-semibold tracking-wider text-red uppercase">
            Not
          </span>
          <span class="font-body text-[0.72rem] font-semibold tracking-wider text-red uppercase">
            Scheduled
          </span>
        </div>
      )
    }

    <div class="min-w-0 flex-1 pt-0.5">
      <div class="flex flex-wrap items-baseline gap-2.5">
        <h1 class="text-balance font-display text-[1.28rem] font-bold">
          {listing.title}
        </h1>
        <span
          class="rounded-sm border border-rule px-1.5 py-px font-body text-[0.65rem] font-semibold tracking-wider text-ink-soft uppercase whitespace-nowrap"
        >
          {listing.type === "mic" ? "Mic" : "Show"}
        </span>
      </div>

      {
        timeLabel && (
          <p class="mt-1 font-mono text-[0.92rem] text-ink-soft tabular-nums">
            {timeLabel}
          </p>
        )
      }

      {
        isSoon && (
          <span class="mt-1.5 inline-flex items-center gap-1.5 text-[0.78rem] font-medium text-gold-ink before:h-1.75 before:w-1.75 before:flex-none before:rounded-full before:bg-gold">
            This week
          </span>
        )
      }

      {
        changeNote && (
          <p class="mt-2 text-[0.86rem] font-medium text-red">
            Changed: {changeNote}
          </p>
        )
      }

      {
        !occurrence && (
          <p class="mt-2 text-[0.86rem] font-medium text-red">
            Not currently scheduled — check back later, or report it if this
            seems wrong.
          </p>
        )
      }
    </div>
  </div>

  <div class="mt-8">
    <p class="text-[0.94rem] font-semibold">{listing.venue.name}</p>
    <p class="mt-0.5 text-[0.86rem] text-ink-soft">
      {listing.venue.address}
      {
        listing.venue.googleMapsUrl && (
          <>
            {" "}
            ·{" "}
            <a
              href={listing.venue.googleMapsUrl}
              target="_blank"
              rel="noopener"
              class="text-ink underline underline-offset-2"
            >
              Directions
            </a>
          </>
        )
      }
    </p>
  </div>

  {
    listing.host && (
      <p class="mt-2 text-[0.86rem] text-ink-soft">
        Hosted by {listing.host}
      </p>
    )
  }

  {
    listing.description && (
      <p class="mt-4 max-w-[65ch] text-[1rem] leading-normal">
        {listing.description}
      </p>
    )
  }

  {
    listing.type === "mic" &&
      (listing.signUpMethod || listing.costToPerform) && (
        <dl class="mt-8 grid grid-cols-[auto_1fr] items-baseline gap-x-4 gap-y-2 border-t border-rule pt-6 text-[0.94rem]">
          {listing.signUpMethod && (
            <>
              <dt class={label}>Sign-up</dt>
              <dd>{listing.signUpMethod}</dd>
            </>
          )}
          {listing.costToPerform && (
            <>
              <dt class={label}>Cost to perform</dt>
              <dd class="capitalize">{listing.costToPerform}</dd>
            </>
          )}
        </dl>
      )
  }

  {
    listing.type === "show" &&
      occurrence &&
      (listing.ticketPrice || listing.ticketUrl) && (
      <div class="mt-8 border-t border-rule pt-6">
        {listing.ticketPrice && (
          <p class="text-[0.95rem] font-semibold capitalize">
            {listing.ticketPrice}
          </p>
        )}
        {listing.ticketUrl && (
          <a
            href={listing.ticketUrl}
            target="_blank"
            rel="noopener"
            class="mt-3 inline-block rounded-sm border border-ink bg-ink px-4 py-1.75 font-display text-[0.95rem] font-bold tracking-wide text-paper uppercase"
          >
            Buy tickets
          </a>
        )}
      </div>
    )
  }

  <p class="mt-10 border-t border-rule pt-6 text-[0.86rem] text-ink-soft">
    See something wrong?{" "}
    <a
      href={`/listings/${listing.id}/report`}
      class="text-ink-soft underline-offset-2 hover:underline"
    >
      Report a problem
    </a>{" "}
    with this listing.
  </p>
</Base>
