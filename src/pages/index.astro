---
import Base from "../layouts/Base.astro";
import Masthead from "../components/masthead/Masthead.astro";
import FilterBar from "../components/filters/FilterBar.astro";
import ListingList from "../components/listings/ListingList.astro";
import {
  getPublishedListings,
  getExceptionsForListings,
  getAreas,
  toRecurrenceListing,
} from "../lib/data/listings";
import { resolveOccurrences } from "../lib/utils/recurrence";

const typeFilter = Astro.url.searchParams.get("type") || null;
const areaFilter = Astro.url.searchParams.get("area") || null;

const [listings, areas] = await Promise.all([
  getPublishedListings(),
  getAreas(),
]);
const exceptionsByListing = await getExceptionsForListings(
  listings.map((l) => l.id),
);

const today = new Date();

function daysFromToday(days: number): string {
  const date = new Date(today);
  date.setUTCDate(date.getUTCDate() + days);
  return date.toISOString().slice(0, 10);
}

const rangeStart = daysFromToday(0);
// The browse window (what's fetched/shown) is wider than the "soon" window
// (what gets the gold This-week flag) — two distinct ranges sharing the same
// start, not one range reused for both purposes.
const browseRangeEnd = daysFromToday(30);
const soonRangeEnd = daysFromToday(7);

// Every listing in range is always rendered (hidden via a boolean prop
// rather than filtered out server-side) so the client-side filter script
// can toggle visibility instantly without a page reload; without JS, the
// server-computed `hidden` still reflects the current query params.
const rows = listings
  .flatMap((listing) => {
    const occurrences = resolveOccurrences(
      toRecurrenceListing(listing),
      exceptionsByListing.get(listing.id) ?? [],
      rangeStart,
      browseRangeEnd,
    );
    return occurrences.map((occurrence) => ({ listing, occurrence }));
  })
  .sort((a, b) => a.occurrence.date.localeCompare(b.occurrence.date))
  .map(({ listing, occurrence }) => {
    const matchesType = !typeFilter || listing.type === typeFilter;
    const matchesArea = !areaFilter || listing.venue.areaId === areaFilter;
    const isSoon =
      occurrence.date >= rangeStart && occurrence.date <= soonRangeEnd;
    return {
      id: listing.id,
      title: listing.title,
      type: listing.type,
      areaId: listing.venue.areaId,
      venueName: listing.venue.name,
      host: listing.host,
      signUpMethod: listing.signUpMethod,
      costToPerform: listing.costToPerform,
      ticketPrice: listing.ticketPrice,
      ticketUrl: listing.ticketUrl,
      date: occurrence.date,
      startTime: occurrence.startTime,
      note: occurrence.note,
      isSoon,
      hidden: !(matchesType && matchesArea),
    };
  });

const visibleCount = rows.filter((row) => !row.hidden).length;

const dateLabel = new Intl.DateTimeFormat("en-US", {
  weekday: "short",
  month: "short",
  day: "numeric",
  timeZone: "UTC",
}).format(today);

const areaName = areaFilter
  ? (areas.find((area) => area.id === areaFilter)?.name ?? null)
  : null;
const scopeLabel = areaName ? `in ${areaName}` : "across LA";
---

<Base title="Crowd Work — LA Open Mics & Comedy Shows">
  <Masthead
    dateLabel={dateLabel}
    listingCount={visibleCount}
    scopeLabel={scopeLabel}
  />
  <FilterBar areas={areas} typeFilter={typeFilter} areaFilter={areaFilter} />
  <ListingList rows={rows} />
</Base>
