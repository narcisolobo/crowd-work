---
import Button from "../../../components/forms/Button.astro";
import FormTextarea from "../../../components/forms/FormTextarea.astro";
import AdminUtilityBar from "../../../components/layout/AdminUtilityBar.astro";
import CancellationApprovalForm from "../../../components/moderation/CancellationApprovalForm.astro";
import ListingApprovalForm from "../../../components/moderation/ListingApprovalForm.astro";
import AdminLayout from "../../../layouts/AdminLayout.astro";
import { getNeighborhoods, getVenues } from "../../../lib/data/listings";
import {
  getPrefillForEntry,
  getQueueEntryById,
  handleQueueReviewAction,
  type ProposedCancellation,
  type QueueChangeType,
} from "../../../lib/data/moderation";
import {
  ORIGIN_LABEL,
  STATUS_LABEL,
} from "../../../lib/utils/moderation-labels";

const { id } = Astro.params;
const supabase = Astro.locals.supabase!;
const user = Astro.locals.user!;

if (!id) {
  return Astro.redirect("/admin");
}

let entry = await getQueueEntryById(supabase, id);

if (!entry) {
  return Astro.redirect("/admin");
}

const [venues, neighborhoods] = await Promise.all([
  getVenues(),
  getNeighborhoods(),
]);
let errorMessage: string | null = null;
let submittedReason = "";
let submittedOtherReason = "";

if (Astro.request.method === "POST") {
  const formData = await Astro.request.formData();
  const action = formData.get("action")?.toString();
  if (action === "approve" || action === "approve_cancellation") {
    submittedReason = formData.get("reason")?.toString() ?? "";
    submittedOtherReason = formData.get("otherReason")?.toString() ?? "";
  }

  try {
    const result = await handleQueueReviewAction(supabase, entry, formData);
    if (result?.type === "redirect") {
      return Astro.redirect("/admin");
    }
    if (result?.type === "validation_error") {
      errorMessage = result.message;
    }
  } catch (error) {
    errorMessage =
      error instanceof Error ? error.message : "Something went wrong.";
    entry = (await getQueueEntryById(supabase, id))!;
  }
}

const prefill = await getPrefillForEntry(entry);
const proposedCancellation =
  entry.changeType === "cancellation"
    ? (entry.proposedData as ProposedCancellation)
    : null;
const isOwnProposal = entry.proposedBy === user.id;

const CHANGE_TYPE_LABEL: Record<QueueChangeType, string> = {
  new: "New listing",
  update: "Update",
  cancellation: "Cancellation",
};

const venueOptions = venues.map((venue) => ({
  value: venue.id,
  label: venue.name,
}));

const neighborhoodOptions = neighborhoods.map((neighborhood) => ({
  value: neighborhood.id,
  label: neighborhood.name,
}));
---

<AdminLayout title="Review entry — Crowd Work admin" userEmail={user.email}>
  <AdminUtilityBar backHref="/admin" backLabel="Back to queue" />

  <div class="mt-5 flex flex-wrap items-center gap-3">
    <h1 class="font-display text-[1.28rem] font-bold">
      {CHANGE_TYPE_LABEL[entry.changeType]}
    </h1>
    <span
      class="border-rule font-body text-ink-soft rounded-sm border px-1.5 py-px text-[0.65rem] font-semibold tracking-wider uppercase"
    >
      {ORIGIN_LABEL[entry.origin] ?? entry.origin}
    </span>
  </div>

  <p class="text-ink-soft mt-1.5 text-[0.86rem]">
    Status: <span class="text-ink font-medium"
      >{STATUS_LABEL[entry.status]}</span
    >
  </p>

  {
    errorMessage && (
      <p
        role="alert"
        class="bg-paper-shadow text-ink mt-5 rounded-sm px-3.5 py-2.5 text-[0.86rem] font-medium"
      >
        <strong>Error:</strong> {errorMessage}
      </p>
    )
  }

  {
    entry.correctionNote && (
      <div class="border-l-rule bg-paper-shadow mt-6 rounded-sm border-l-[3px] px-4 py-3.5">
        <p class="font-body text-ink-soft text-[0.65rem] font-semibold tracking-wider uppercase">
          Reporter's note
        </p>
        <p class="text-ink mt-1.5 text-[0.95rem] italic">
          "{entry.correctionNote}"
        </p>
      </div>
    )
  }

  {
    entry.changeType === "cancellation" ? (
      <CancellationApprovalForm
        entry={entry}
        proposedCancellation={proposedCancellation}
        reason={submittedReason}
        otherReason={submittedOtherReason}
      />
    ) : (
      <ListingApprovalForm
        entry={entry}
        prefill={prefill}
        venueOptions={venueOptions}
        neighborhoodOptions={neighborhoodOptions}
        reason={submittedReason}
        otherReason={submittedOtherReason}
      />
    )
  }

  {
    entry.status === "pending" && (
      <form
        method="post"
        class="border-rule mt-10 flex max-w-104 flex-col gap-3 border-t pt-6"
      >
        <input type="hidden" name="action" value="propose_reject" />
        <FormTextarea label="Reason for rejection" name="reason" required />
        <Button type="submit" variant="outline" class="self-start">
          Propose rejection
        </Button>
      </form>
    )
  }

  {
    entry.status === "rejection_proposed" && (
      <div class="border-rule mt-10 border-t pt-6">
        <p class="text-[0.94rem]">
          <span class="font-medium">Rejection proposed</span> —{" "}
          {entry.proposedReason}
        </p>
        {isOwnProposal ? (
          <p class="text-ink-soft mt-3 text-[0.86rem]">
            You proposed this rejection — a different moderator must confirm it.
          </p>
        ) : (
          <div class="mt-4 flex flex-wrap gap-3">
            <form method="post">
              <input type="hidden" name="action" value="confirm_reject" />
              <Button type="submit" variant="outline">
                Confirm rejection
              </Button>
            </form>
            <form method="post">
              <input type="hidden" name="action" value="send_back" />
              <Button type="submit" variant="outline">
                Send back to pending
              </Button>
            </form>
          </div>
        )}
      </div>
    )
  }
</AdminLayout>

<script>
  const reasonSelects = document.querySelectorAll<HTMLSelectElement>(
    'select[name="reason"]',
  );
  for (const select of reasonSelects) {
    const container = select
      .closest("form")
      ?.querySelector<HTMLElement>("[data-other-reason]");
    if (!container) continue;
    const sync = () => {
      container.hidden = select.value !== "other";
    };
    select.addEventListener("change", sync);
    sync();
  }
</script>
