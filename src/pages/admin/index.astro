---
import AdminLayout from "../../layouts/AdminLayout.astro";
import {
  getReviewableQueueEntries,
  type QueueEntry,
  type QueueChangeType,
  type ProposedListingFields,
} from "../../lib/data/moderation";

const supabase = Astro.locals.supabase!;
const user = Astro.locals.user!;
const entries = await getReviewableQueueEntries(supabase);

const CHANGE_TYPE_LABEL: Record<QueueChangeType, string> = {
  new: "New",
  update: "Update",
  cancellation: "Cancellation",
};

const ORIGIN_LABEL: Record<string, string> = {
  seed: "Seed data",
  report_form: "Public report",
};

function previewFor(entry: QueueEntry): string {
  if (entry.correctionNote) {
    return entry.correctionNote.length > 90
      ? `${entry.correctionNote.slice(0, 90)}…`
      : entry.correctionNote;
  }
  const data = entry.proposedData as ProposedListingFields | null;
  if (data?.title) {
    return entry.changeType === "new"
      ? `New listing: ${data.title}`
      : `Update: ${data.title}`;
  }
  return "Cancellation";
}

function dateLabel(createdAt: string): string {
  return new Date(createdAt).toLocaleDateString("en-US", {
    month: "short",
    day: "numeric",
  });
}
---

<AdminLayout title="Moderation queue — Crowd Work admin" userEmail={user.email}>
  <div class="border-b border-rule pt-8 pb-5">
    <h1 class="font-display text-[1.28rem] font-bold">Moderation queue</h1>
    <p class="mt-2 text-[0.95rem]">
      <strong class="font-semibold text-gold-ink">
        {entries.length} {entries.length === 1 ? "entry" : "entries"}
      </strong>{" "}
      waiting on review.
    </p>
  </div>

  {
    entries.length === 0 ? (
      <p class="py-10 text-[0.95rem] text-ink-soft">
        Nothing to review right now.
      </p>
    ) : (
      <ul class="m-0 list-none p-0">
        {entries.map((entry) => {
          const needsAttention = entry.status === "rejection_proposed";
          return (
            <li
              class:list={[
                "flex items-start justify-between gap-4 border-b border-rule py-5",
                needsAttention &&
                  "border-l-[3px] border-l-[color-mix(in_srgb,var(--gold)_60%,var(--paper)_40%)] pl-3.5",
              ]}
            >
              <div class="flex items-start gap-3.5">
                <span class="mt-0.5 rounded-sm border border-rule px-1.5 py-px font-body text-[0.65rem] font-semibold tracking-wider text-ink-soft uppercase whitespace-nowrap">
                  {CHANGE_TYPE_LABEL[entry.changeType]}
                </span>
                <div>
                  <h2 class="font-body text-[0.95rem] font-medium">
                    <a
                      href={`/admin/queue/${entry.id}`}
                      class="underline-offset-2 hover:underline"
                    >
                      {previewFor(entry)}
                    </a>
                  </h2>
                  <p class="mt-1 text-[0.82rem] text-ink-soft">
                    {ORIGIN_LABEL[entry.origin] ?? entry.origin} ·{" "}
                    {dateLabel(entry.createdAt)}
                  </p>
                  {needsAttention && (
                    <span class="mt-1.5 inline-flex items-center gap-1.5 text-[0.78rem] font-medium text-gold-ink before:h-1.75 before:w-1.75 before:flex-none before:rounded-full before:bg-gold">
                      Rejection proposed — needs a second moderator
                    </span>
                  )}
                </div>
              </div>
              <a
                href={`/admin/queue/${entry.id}`}
                aria-hidden="true"
                tabindex="-1"
                class="mt-1.5 flex-none text-ink-soft"
              >
                <svg
                  class="h-3 w-3 -rotate-90"
                  viewBox="0 0 12 12"
                  fill="none"
                >
                  <path
                    d="M3 4.5L6 7.5L9 4.5"
                    stroke="currentColor"
                    stroke-width="1.3"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
              </a>
            </li>
          );
        })}
      </ul>
    )
  }
</AdminLayout>
