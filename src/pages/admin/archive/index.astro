---
import Button from "../../../components/forms/Button.astro";
import FormSelect from "../../../components/forms/FormSelect.astro";
import FormTextarea from "../../../components/forms/FormTextarea.astro";
import AdminUtilityBar from "../../../components/layout/AdminUtilityBar.astro";
import AdminLayout from "../../../layouts/AdminLayout.astro";
import {
  findMissingReason,
  getArchiveEntries,
  parseApprovalNote,
  restoreListing,
  type QueueEntry,
} from "../../../lib/data/moderation";
import { getModeratorEmails } from "../../../lib/data/moderators";
import { getListingStatuses, getListingTitles } from "../../../lib/data/listings";
import {
  CHANGE_TYPE_LABEL,
  ORIGIN_LABEL,
  RESTORE_REASON_HINT,
  RESTORE_REASON_OPTIONS,
  STATUS_LABEL,
  previewFor,
  truncate,
} from "../../../lib/utils/moderation-labels";

const supabase = Astro.locals.supabase!;
const user = Astro.locals.user!;

let errorListingId: string | null = null;
let errorMessage: string | null = null;
let fieldErrors: Record<string, string> = {};
let submittedReason = "";
let submittedOtherReason = "";

if (Astro.request.method === "POST") {
  const formData = await Astro.request.formData();
  const listingId = formData.get("listingId")?.toString() ?? "";
  const redirectStatus = formData.get("redirectStatus")?.toString() ?? "";
  submittedReason = formData.get("reason")?.toString() ?? "";
  submittedOtherReason = formData.get("otherReason")?.toString() ?? "";

  const missingReason = findMissingReason(formData);
  if (missingReason.length > 0) {
    errorListingId = listingId;
    errorMessage = "Choose a reason for restoring this listing.";
    fieldErrors = Object.fromEntries(
      missingReason.map(({ field }) => [field, "Required."]),
    );
  } else {
    try {
      const reason = parseApprovalNote(formData) ?? "";
      await restoreListing(supabase, listingId, reason);
      const redirectUrl = redirectStatus
        ? `/admin/archive?status=${encodeURIComponent(redirectStatus)}&restored=1`
        : "/admin/archive?restored=1";
      return Astro.redirect(redirectUrl);
    } catch (error) {
      errorListingId = listingId;
      errorMessage =
        error instanceof Error ? error.message : "Something went wrong.";
    }
  }
}

const statusFilter = Astro.url.searchParams.get("status") || "";
const justRestored = Astro.url.searchParams.get("restored") === "1";

const entries = await getArchiveEntries(supabase);

const moderatorIds = entries.flatMap((entry) =>
  [entry.approvedBy, entry.proposedBy, entry.confirmedBy].filter(
    (id): id is string => Boolean(id),
  ),
);
const moderatorEmails = await getModeratorEmails(supabase, moderatorIds);

const archiveOrRestoreListingIds = entries
  .filter(
    (entry): entry is typeof entry & { listingId: string } =>
      (entry.changeType === "archive" || entry.changeType === "restore") &&
      entry.listingId !== null,
  )
  .map((entry) => entry.listingId);
const listingTitles = await getListingTitles(
  supabase,
  archiveOrRestoreListingIds,
);

// Only the most recent 'archive' entry per listing should offer a Restore
// action — entries are already ordered newest-first (getArchiveEntries), so
// the first 'archive' entry seen per listingId is the one that still holds;
// an older, already-superseded archive entry for the same listing must not
// also grow a Restore button. Whether it holds at all depends on the
// listing's actual current status, not on queue history, since a listing
// can be archived and restored more than once.
const archiveListingIds = [
  ...new Set(
    entries
      .filter((entry) => entry.changeType === "archive" && entry.listingId)
      .map((entry) => entry.listingId!),
  ),
];
const listingStatuses = await getListingStatuses(supabase, archiveListingIds);

const restoreEligibleEntryIds = new Set<string>();
const listingsAlreadyOffered = new Set<string>();
for (const entry of entries) {
  if (entry.changeType !== "archive" || !entry.listingId) continue;
  if (listingsAlreadyOffered.has(entry.listingId)) continue;
  listingsAlreadyOffered.add(entry.listingId);
  if (listingStatuses[entry.listingId] === "archived") {
    restoreEligibleEntryIds.add(entry.id);
  }
}

function whoFor(entry: QueueEntry): string {
  if (entry.status === "approved") {
    const approver = entry.approvedBy
      ? (moderatorEmails[entry.approvedBy] ?? "Unknown moderator")
      : "Unknown moderator";
    return `Approved by ${approver}`;
  }
  const proposer = entry.proposedBy
    ? (moderatorEmails[entry.proposedBy] ?? "Unknown moderator")
    : "Unknown moderator";
  const confirmer = entry.confirmedBy
    ? (moderatorEmails[entry.confirmedBy] ?? "Unknown moderator")
    : "Unknown moderator";
  return `Proposed by ${proposer}, confirmed by ${confirmer}`;
}

function whatFor(entry: QueueEntry): string {
  return previewFor(
    {
      correctionNote: entry.correctionNote,
      proposedData:
        entry.status === "approved" ? entry.approvedData : entry.proposedData,
      changeType: entry.changeType,
    },
    entry.listingId ? listingTitles[entry.listingId] : null,
  );
}

function whyFor(entry: QueueEntry): string {
  const reason =
    entry.status === "approved" ? entry.approvalNote : entry.proposedReason;
  return reason ? truncate(reason) : "—";
}

function whenFor(decidedAt: string | null): string {
  if (!decidedAt) return "—";
  return new Date(decidedAt).toLocaleDateString("en-US", {
    month: "short",
    day: "numeric",
  });
}

const tabs = [
  { value: "", label: "All" },
  { value: "approved", label: "Approved" },
  { value: "rejected", label: "Rejected" },
];

const rows = entries.map((entry) => ({
  entry,
  hidden: statusFilter !== "" && entry.status !== statusFilter,
}));
const visibleCount = rows.filter((row) => !row.hidden).length;
const hasVisibleRows = visibleCount > 0;
const activeTabLabel =
  tabs.find((tab) => tab.value === statusFilter)?.label ?? "";
---

<AdminLayout
  title="Moderation Archive — Crowd Work Admin"
  userEmail={user.email}
>
  <AdminUtilityBar backHref="/admin" backLabel="Back to queue" />

  <div class="border-rule mt-5 border-b pb-5">
    <h1 class="font-display text-[1.28rem] font-bold">Moderation Archive</h1>
    <p class="text-ink-soft mt-2 text-[0.95rem]">
      Every decided entry — who acted, what was written, and why.
    </p>
  </div>

  <form
    method="get"
    id="archive-filter"
    class="border-rule flex gap-1.5 border-b py-5"
    role="group"
    aria-label="Filter by status"
  >
    {
      tabs.map((tab) => {
        const pressed = statusFilter === tab.value;
        return (
          <button
            type="submit"
            name="status"
            value={tab.value}
            aria-pressed={pressed}
            class:list={[
              "font-display cursor-pointer rounded-sm border px-4 py-1.75 text-[0.95rem] font-bold tracking-wide uppercase",
              pressed
                ? "border-ink bg-ink text-paper"
                : "border-rule text-ink-soft bg-transparent",
            ]}
          >
            {tab.label}
          </button>
        );
      })
    }
  </form>

  {
    justRestored && (
      <p
        role="status"
        class="bg-paper-shadow mt-5 rounded-sm border-l-[3px] border-l-[color-mix(in_srgb,var(--gold)_60%,var(--paper)_40%)] px-3.5 py-2.5 text-[0.86rem] font-medium"
      >
        Listing restored — it's back on the public site.
      </p>
    )
  }

  {
    entries.length === 0 ? (
      <p class="text-ink-soft py-10 text-[0.95rem]">
        Nothing has been decided yet.
      </p>
    ) : (
      <>
        <p
          data-archive-count
          aria-live="polite"
          hidden={!hasVisibleRows}
          class="text-ink-soft py-3 text-[0.82rem]"
        >
          <strong class="text-gold-ink font-semibold" data-count>
            {visibleCount}
          </strong>{" "}
          <span data-count-label>
            {visibleCount === 1 ? "entry" : "entries"}
          </span>
        </p>
        <p
          data-archive-empty-filter
          aria-live="polite"
          hidden={hasVisibleRows}
          class="text-ink-soft py-10 text-[0.95rem]"
        >
          No {activeTabLabel.toLowerCase()} entries.
        </p>
        <ul class="m-0 list-none p-0">
          {rows.map(({ entry, hidden }) => {
            const canRestore = restoreEligibleEntryIds.has(entry.id);
            const rowHasError = canRestore && errorListingId === entry.listingId;
            return (
              <li
                data-archive-row
                data-status={entry.status}
                hidden={hidden}
                class="border-rule flex flex-col gap-1.5 border-b py-5"
              >
                <div class="flex flex-wrap items-center gap-3">
                  <span class="border-rule font-body text-ink-soft rounded-sm border px-1.5 py-px text-[0.65rem] font-semibold tracking-wider uppercase">
                    {CHANGE_TYPE_LABEL[entry.changeType]}
                  </span>
                  <span class="text-[0.95rem] font-medium">
                    {STATUS_LABEL[entry.status]}
                  </span>
                  <span class="text-ink-soft text-[0.82rem]">
                    {ORIGIN_LABEL[entry.origin] ?? entry.origin} ·{" "}
                    {whenFor(entry.decidedAt)}
                  </span>
                </div>
                <p class="text-[0.9rem] wrap-break-word">{whatFor(entry)}</p>
                <p class="text-ink-soft text-[0.82rem] wrap-break-word">
                  {whoFor(entry)}
                </p>
                <p class="text-ink-soft text-[0.82rem] italic wrap-break-word">
                  {whyFor(entry)}
                </p>
                {canRestore && (
                  <details open={rowHasError} class="mt-1.5">
                    <summary class="font-display text-ink-soft hover:text-ink inline-block cursor-pointer text-[0.82rem] font-bold tracking-wide [&::-webkit-details-marker]:hidden">
                      Restore
                    </summary>
                    <form
                      method="post"
                      novalidate
                      class="max-w-form-compact mt-3 flex flex-col gap-4"
                    >
                      <input
                        type="hidden"
                        name="listingId"
                        value={entry.listingId ?? ""}
                      />
                      <input
                        type="hidden"
                        name="redirectStatus"
                        value={statusFilter}
                      />

                      {rowHasError && errorMessage && (
                        <p
                          role="alert"
                          tabindex="-1"
                          data-row-error
                          class="border-l-error text-error bg-paper rounded-sm border-l-[3px] px-3.5 py-2.5 text-[0.86rem] font-medium"
                        >
                          <strong>Error:</strong> {errorMessage}
                        </p>
                      )}

                      <FormSelect
                        label="Reason"
                        name="reason"
                        options={RESTORE_REASON_OPTIONS}
                        value={rowHasError ? submittedReason : ""}
                        required
                        error={rowHasError ? fieldErrors.reason : undefined}
                        hint={RESTORE_REASON_HINT}
                      />
                      <div
                        data-other-reason
                        hidden={!rowHasError || submittedReason !== "other"}
                      >
                        <FormTextarea
                          label="Other reason"
                          name="otherReason"
                          value={rowHasError ? submittedOtherReason : ""}
                          required
                          error={
                            rowHasError ? fieldErrors.otherReason : undefined
                          }
                        />
                      </div>

                      <Button
                        type="submit"
                        variant="outline"
                        busyLabel="Restoring…"
                      >
                        Restore this listing
                      </Button>
                    </form>
                  </details>
                )}
              </li>
            );
          })}
        </ul>
      </>
    )
  }
</AdminLayout>

<script>
  const form = document.getElementById(
    "archive-filter",
  ) as HTMLFormElement | null;
  if (form) {
    const buttons = Array.from(
      form.querySelectorAll<HTMLButtonElement>('button[name="status"]'),
    );
    const rows = Array.from(
      document.querySelectorAll<HTMLElement>("[data-archive-row]"),
    );
    const emptyFilterMessage = document.querySelector<HTMLElement>(
      "[data-archive-empty-filter]",
    );
    const countMessage = document.querySelector<HTMLElement>(
      "[data-archive-count]",
    );
    const countValue = countMessage?.querySelector("[data-count]") ?? null;
    const countLabel =
      countMessage?.querySelector("[data-count-label]") ?? null;
    let activeStatus =
      buttons.find((btn) => btn.getAttribute("aria-pressed") === "true")
        ?.value ?? "";

    function applyFilter() {
      let visibleCount = 0;
      for (const row of rows) {
        const matches =
          activeStatus === "" || row.dataset.status === activeStatus;
        row.hidden = !matches;
        if (matches) visibleCount += 1;
      }
      if (countMessage) {
        countMessage.hidden = visibleCount === 0;
        if (countValue) countValue.textContent = String(visibleCount);
        if (countLabel) {
          countLabel.textContent = visibleCount === 1 ? "entry" : "entries";
        }
      }
      if (emptyFilterMessage) {
        emptyFilterMessage.hidden = visibleCount > 0;
        const activeLabel = buttons
          .find((btn) => btn.value === activeStatus)
          ?.textContent?.trim()
          .toLowerCase();
        if (activeLabel) {
          emptyFilterMessage.textContent = `No ${activeLabel} entries.`;
        }
      }
    }

    function setActive(value: string) {
      activeStatus = value;
      for (const btn of buttons) {
        const pressed = btn.value === value;
        btn.setAttribute("aria-pressed", String(pressed));
        btn.classList.toggle("border-ink", pressed);
        btn.classList.toggle("bg-ink", pressed);
        btn.classList.toggle("text-paper", pressed);
        btn.classList.toggle("border-rule", !pressed);
        btn.classList.toggle("bg-transparent", !pressed);
        btn.classList.toggle("text-ink-soft", !pressed);
      }
    }

    for (const button of buttons) {
      button.addEventListener("click", (event) => {
        event.preventDefault();
        setActive(button.value);
        applyFilter();
        const url = new URL(window.location.href);
        if (activeStatus) url.searchParams.set("status", activeStatus);
        else url.searchParams.delete("status");
        window.history.pushState({}, "", url);
      });
    }

    applyFilter();
  }

  const reasonSelects = document.querySelectorAll<HTMLSelectElement>(
    'select[name="reason"]',
  );
  for (const select of reasonSelects) {
    const container = select
      .closest("form")
      ?.querySelector<HTMLElement>("[data-other-reason]");
    if (!container) continue;
    const sync = () => {
      container.hidden = select.value !== "other";
    };
    select.addEventListener("change", sync);
    sync();
  }

  // Mirrors the same fix on the listings page: a server-side restore
  // failure reopens the failing row's <details> but on a long archive log
  // that row can be far below the fold, so scroll to and focus it.
  const rowError = document.querySelector<HTMLElement>("[data-row-error]");
  if (rowError) {
    rowError.scrollIntoView({ block: "center", behavior: "smooth" });
    rowError.focus();
  }
</script>
