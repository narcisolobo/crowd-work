---
import FormField from "../forms/FormField.astro";
import FormSelect from "../forms/FormSelect.astro";
import FormTextarea from "../forms/FormTextarea.astro";
import type { ProposedListingFields } from "../../lib/data/moderation";
import {
  DAY_OF_WEEK_OPTIONS,
  FREQUENCY_OPTIONS,
  TYPE_OPTIONS,
  WEEK_OF_MONTH_OPTIONS,
} from "../../lib/utils/moderation-labels";

interface Props {
  prefill: ProposedListingFields | null;
  venueOptions: { value: string; label: string }[];
  neighborhoodOptions: { value: string; label: string }[];
  fieldErrors?: Record<string, string>;
}

const {
  prefill,
  venueOptions,
  neighborhoodOptions,
  fieldErrors = {},
} = Astro.props;

const venueSelectOptions = [
  { value: "", label: "Choose a venue" },
  ...venueOptions,
  { value: "__new__", label: "Add a new venue…" },
];
const neighborhoodSelectOptions = [
  { value: "", label: "Choose a neighborhood" },
  ...neighborhoodOptions,
];
const isNewVenue = Boolean(prefill?.newVenue);
const initialType = prefill?.type ?? "mic";
const isRecurring = Boolean(prefill?.recurrence?.frequency);
const isMonthly = prefill?.recurrence?.frequency === "monthly";
---

<p class="font-body text-ink-soft text-[0.82rem]">
  Fields marked <span aria-hidden="true">*</span> are required.
</p>

<div class="flex flex-col gap-4">
  <p
    class="font-body text-ink-soft text-[0.65rem] font-semibold tracking-wider uppercase"
  >
    What it is
  </p>
  <FormSelect
    label="Type"
    name="type"
    options={TYPE_OPTIONS}
    value={initialType}
  />
  <FormField
    label="Title"
    name="title"
    value={prefill?.title ?? ""}
    required
    error={fieldErrors.title}
  />
  <div data-field-for="mic" hidden={initialType === "show"}>
    <FormField label="Host" name="host" value={prefill?.host ?? ""} />
  </div>
  <FormTextarea
    label="Description"
    name="description"
    value={prefill?.description ?? ""}
  />
</div>

<div class="border-rule flex flex-col gap-4 border-t pt-6">
  <p
    class="font-body text-ink-soft text-[0.65rem] font-semibold tracking-wider uppercase"
  >
    Venue
  </p>
  <FormSelect
    label="Venue"
    name="venueId"
    options={venueSelectOptions}
    value={isNewVenue ? "__new__" : (prefill?.venueId ?? "")}
    required
    error={fieldErrors.venueId}
  />
  <div data-new-venue hidden={!isNewVenue} class="flex flex-col gap-4">
    <FormField
      label="Venue name"
      name="newVenueName"
      value={prefill?.newVenue?.name ?? ""}
      required
      error={fieldErrors.newVenueName}
    />
    <FormField
      label="Venue address"
      name="newVenueAddress"
      value={prefill?.newVenue?.address ?? ""}
      required
      error={fieldErrors.newVenueAddress}
    />
    <FormSelect
      label="Neighborhood"
      name="newVenueNeighborhoodId"
      options={neighborhoodSelectOptions}
      value={prefill?.newVenue?.neighborhoodId ?? ""}
      required
      error={fieldErrors.newVenueNeighborhoodId}
    />
    <FormField
      label="Google Maps URL"
      name="newVenueGoogleMapsUrl"
      type="url"
      value={prefill?.newVenue?.googleMapsUrl ?? ""}
    />
  </div>
</div>

<div class="border-rule flex flex-col gap-4 border-t pt-6">
  <p
    class="font-body text-ink-soft text-[0.65rem] font-semibold tracking-wider uppercase"
  >
    Timing & cost
  </p>
  <FormField
    label="Start time"
    name="startTime"
    type="time"
    value={prefill?.startTime ?? ""}
    required
    error={fieldErrors.startTime}
  />
  <div data-field-for="mic" hidden={initialType === "show"}>
    <FormField
      label="Sign-up method"
      name="signUpMethod"
      value={prefill?.signUpMethod ?? ""}
    />
  </div>
  <div data-field-for="mic" hidden={initialType === "show"}>
    <FormField
      label="Cost to perform"
      name="costToPerform"
      value={prefill?.costToPerform ?? ""}
    />
  </div>
  <div data-field-for="show" hidden={initialType !== "show"}>
    <FormField
      label="Ticket price"
      name="ticketPrice"
      value={prefill?.ticketPrice ?? ""}
    />
  </div>
  <div data-field-for="show" hidden={initialType !== "show"}>
    <FormField
      label="Ticket URL"
      name="ticketUrl"
      type="url"
      value={prefill?.ticketUrl ?? ""}
    />
  </div>
</div>

<div class="border-rule flex flex-col gap-4 border-t pt-6">
  <p
    class="font-body text-ink-soft text-[0.65rem] font-semibold tracking-wider uppercase"
  >
    Recurrence
  </p>
  <FormSelect
    label="Frequency"
    name="frequency"
    options={FREQUENCY_OPTIONS}
    value={prefill?.recurrence?.frequency ?? ""}
  />
  <div data-recurrence-for="recurring" hidden={!isRecurring}>
    <FormSelect
      label="Day of week"
      name="dayOfWeek"
      options={DAY_OF_WEEK_OPTIONS}
      value={prefill?.recurrence?.dayOfWeek ?? ""}
    />
  </div>
  <div data-recurrence-for="monthly" hidden={!isMonthly}>
    <FormSelect
      label="Week of month"
      name="weekOfMonth"
      options={WEEK_OF_MONTH_OPTIONS}
      value={prefill?.recurrence?.weekOfMonth ?? ""}
    />
  </div>
  <div data-recurrence-for="one-time" hidden={isRecurring}>
    <FormField
      label="One-off date (if not recurring)"
      name="oneOffDate"
      type="date"
      value={prefill?.oneOffDate ?? ""}
    />
  </div>
</div>

<script>
  const setGroupState = (elements: HTMLElement[], hide: boolean) => {
    for (const el of elements) {
      el.hidden = hide;
      for (const field of el.querySelectorAll<
        HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement
      >("input, select, textarea")) {
        field.disabled = hide;
      }
    }
  };

  const typeSelects = document.querySelectorAll<HTMLSelectElement>(
    'select[name="type"]',
  );
  for (const select of typeSelects) {
    const form = select.closest("form");
    if (!form) continue;
    const micFields = form.querySelectorAll<HTMLElement>(
      '[data-field-for="mic"]',
    );
    const showFields = form.querySelectorAll<HTMLElement>(
      '[data-field-for="show"]',
    );

    const sync = () => {
      const isShow = select.value === "show";
      setGroupState(Array.from(micFields), isShow);
      setGroupState(Array.from(showFields), !isShow);
    };
    select.addEventListener("change", sync);
    sync();
  }

  const frequencySelects = document.querySelectorAll<HTMLSelectElement>(
    'select[name="frequency"]',
  );
  for (const select of frequencySelects) {
    const form = select.closest("form");
    if (!form) continue;
    const recurringFields = form.querySelectorAll<HTMLElement>(
      '[data-recurrence-for="recurring"]',
    );
    const monthlyFields = form.querySelectorAll<HTMLElement>(
      '[data-recurrence-for="monthly"]',
    );
    const oneTimeFields = form.querySelectorAll<HTMLElement>(
      '[data-recurrence-for="one-time"]',
    );

    const sync = () => {
      const isRecurring = select.value !== "";
      const isMonthly = select.value === "monthly";
      setGroupState(Array.from(recurringFields), !isRecurring);
      setGroupState(Array.from(monthlyFields), !isMonthly);
      setGroupState(Array.from(oneTimeFields), isRecurring);
    };
    select.addEventListener("change", sync);
    sync();
  }

  const venueSelects = document.querySelectorAll<HTMLSelectElement>(
    'select[name="venueId"]',
  );
  for (const select of venueSelects) {
    const container = select
      .closest("form")
      ?.querySelector<HTMLElement>("[data-new-venue]");
    if (!container) continue;
    const fields = container.querySelectorAll<
      HTMLInputElement | HTMLSelectElement
    >("input, select");
    const sync = () => {
      const isNewVenue = select.value === "__new__";
      container.hidden = !isNewVenue;
      for (const field of fields) field.disabled = !isNewVenue;
    };
    select.addEventListener("change", sync);
    sync();
  }
</script>
