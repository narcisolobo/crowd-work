---
interface Option {
  value: string;
  label: string;
}

interface Props {
  label: string;
  name: string;
  options: Option[];
  value?: string | number | null;
  required?: boolean;
  error?: string | null;
}

const {
  label,
  name,
  options,
  value = "",
  required = false,
  error = null,
} = Astro.props;
const stringValue = value === null || value === undefined ? "" : String(value);
const errorId = error ? `${name}-error` : undefined;
---

<label class="text-ink-soft flex flex-col gap-1.5 text-[0.82rem] font-medium">
  <span>
    {label}
    {required && <span aria-hidden="true"> *</span>}
  </span>
  <span class="relative block">
    <select
      name={name}
      required={required}
      aria-invalid={error ? "true" : undefined}
      aria-describedby={errorId}
      style={error ? "border-color: var(--error)" : undefined}
      class="border-rule bg-paper font-body text-ink w-full appearance-none rounded-sm border px-3 py-2 pr-8 text-[0.95rem]"
    >
      {
        options.map((option) => (
          <option value={option.value} selected={option.value === stringValue}>
            {option.label}
          </option>
        ))
      }
    </select>
    <svg
      class="text-ink-soft pointer-events-none absolute top-1/2 right-3 h-3 w-3 -translate-y-1/2"
      viewBox="0 0 12 12"
      fill="none"
      aria-hidden="true"
    >
      <path
        d="M3 4.5L6 7.5L9 4.5"
        stroke="currentColor"
        stroke-width="1.3"
        stroke-linecap="round"
        stroke-linejoin="round"></path>
    </svg>
  </span>
  {
    error && (
      <p
        id={errorId}
        data-field-error
        role="alert"
        style="color: var(--error); font-size: 0.78rem; font-weight: 500; margin-top: 0.375rem;"
      >
        {error}
      </p>
    )
  }
</label>

<script>
  import "./form-field-validation";
</script>
