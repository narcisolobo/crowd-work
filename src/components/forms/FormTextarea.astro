---
interface Props {
  label: string;
  name: string;
  value?: string | null;
  required?: boolean;
  rows?: number;
  error?: string | null;
}

const {
  label,
  name,
  value = "",
  required = false,
  rows = 3,
  error = null,
} = Astro.props;
const errorId = error ? `${name}-error` : undefined;
---

<label class="flex flex-col gap-1.5 text-[0.82rem] font-medium text-ink-soft">
  <span>
    {label}
    {required && <span aria-hidden="true"> *</span>}
  </span>
  <textarea
    name={name}
    required={required}
    rows={rows}
    aria-invalid={error ? "true" : undefined}
    aria-describedby={errorId}
    style={error ? "border-color: var(--error)" : undefined}
    class="rounded-sm border border-rule bg-paper px-3 py-2 font-body text-[0.95rem] text-ink"
    >{value ?? ""}</textarea
  >
  {
    error && (
      <p
        id={errorId}
        data-field-error
        role="alert"
        style="color: var(--error); font-size: 0.78rem; font-weight: 500; margin-top: 0.375rem;"
      >
        {error}
      </p>
    )
  }
</label>

<script>
  import "./form-field-validation";
</script>
