---
interface Props {
  type?: "submit" | "button";
  variant?: "primary" | "outline";
  disabled?: boolean;
  href?: string;
  target?: string;
  rel?: string;
  class?: string;
}

const {
  type = "submit",
  variant = "primary",
  disabled = false,
  href,
  target,
  rel,
  class: className = "",
} = Astro.props;

const variants = {
  primary: "border-ink bg-ink text-paper",
  outline: "border-rule bg-transparent text-ink hover:border-ink",
};

const classes = [
  "inline-block cursor-pointer rounded-sm border px-4 py-2 font-display text-[0.95rem] font-bold tracking-wide disabled:cursor-not-allowed disabled:opacity-50",
  variants[variant],
  className,
];
---

{
  href ? (
    <a href={href} target={target} rel={rel} class:list={classes}>
      <slot />
    </a>
  ) : (
    <button type={type} disabled={disabled} class:list={classes}>
      <slot />
    </button>
  )
}
