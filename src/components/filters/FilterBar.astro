---
import FilterSelect from './FilterSelect.astro';

interface Area {
  id: string;
  name: string;
}

interface Props {
  areas: Area[];
  typeFilter: string | null;
  dayFilter: string | null;
  areaFilter: string | null;
}

const { areas, typeFilter, dayFilter, areaFilter } = Astro.props;

const tabs = [
  { value: '', label: 'All' },
  { value: 'mic', label: 'Mics' },
  { value: 'show', label: 'Shows' },
];

const dayNames = [
  'Sunday',
  'Monday',
  'Tuesday',
  'Wednesday',
  'Thursday',
  'Friday',
  'Saturday',
];
const dayOptions = [
  { value: '', label: 'All days' },
  ...dayNames.map((name, index) => ({ value: String(index), label: name })),
];
const areaOptions = [
  { value: '', label: 'All of LA' },
  ...areas.map((area) => ({ value: area.id, label: area.name })),
];
---

<form
  method="get"
  id="filter-bar"
  class="filters flex flex-wrap items-center justify-between gap-4 border-b border-rule py-5"
>
  <div class="flex gap-1.5" role="group" aria-label="Filter by type">
    {
      tabs.map((tab) => {
        const pressed = (typeFilter ?? '') === tab.value;
        return (
          <button
            type="submit"
            name="type"
            value={tab.value}
            aria-pressed={pressed}
            class:list={[
              'cursor-pointer rounded-sm border px-4 py-1.75 font-display text-[0.95rem] font-bold tracking-wide uppercase',
              pressed
                ? 'border-ink bg-ink text-paper'
                : 'border-rule bg-transparent text-ink-soft',
            ]}
          >
            {tab.label}
          </button>
        );
      })
    }
  </div>
  <div class="flex items-center gap-2.5">
    <FilterSelect
      name="day"
      id="day-select"
      ariaLabel="Filter by day of week"
      options={dayOptions}
      value={dayFilter}
    />
    <FilterSelect
      name="area"
      id="area-select"
      ariaLabel="Filter by area"
      options={areaOptions}
      value={areaFilter}
    />
    <button
      type="submit"
      id="apply-filter"
      class="text-[0.86rem] text-gold-ink underline underline-offset-2"
    >
      Apply
    </button>
  </div>
</form>

<script>
  const form = document.getElementById('filter-bar') as HTMLFormElement | null;
  if (form) {
    const typeButtons = Array.from(
      form.querySelectorAll<HTMLButtonElement>('button[name="type"]'),
    );
    const daySelect = form.querySelector<HTMLSelectElement>('select[name="day"]');
    const areaSelect = form.querySelector<HTMLSelectElement>('select[name="area"]');
    const applyButton = document.getElementById('apply-filter');
    const rows = Array.from(
      document.querySelectorAll<HTMLElement>('[data-listing-row]'),
    );
    const emptyState = document.getElementById('empty-state');
    const listingCount = document.getElementById('listing-count');
    const listingScope = document.getElementById('listing-scope');

    let activeType =
      typeButtons.find((btn) => btn.getAttribute('aria-pressed') === 'true')
        ?.value ?? '';
    let activeDay = daySelect?.value ?? '';
    let activeArea = areaSelect?.value ?? '';

    function applyFilters() {
      let visibleCount = 0;
      for (const row of rows) {
        const matchesType = !activeType || row.dataset.type === activeType;
        const matchesDay = !activeDay || row.dataset.day === activeDay;
        const matchesArea = !activeArea || row.dataset.area === activeArea;
        const visible = matchesType && matchesDay && matchesArea;
        row.hidden = !visible;
        if (visible) visibleCount++;
      }
      if (emptyState) emptyState.hidden = visibleCount > 0;
      if (listingCount) {
        listingCount.textContent = `${visibleCount} listing${visibleCount === 1 ? '' : 's'}`;
      }
      if (listingScope) {
        const areaName = areaSelect?.selectedOptions[0]?.textContent;
        listingScope.textContent = activeArea && areaName ? `in ${areaName}` : 'across LA';
      }
    }

    function updateUrl() {
      const url = new URL(window.location.href);
      if (activeType) url.searchParams.set('type', activeType);
      else url.searchParams.delete('type');
      if (activeDay) url.searchParams.set('day', activeDay);
      else url.searchParams.delete('day');
      if (activeArea) url.searchParams.set('area', activeArea);
      else url.searchParams.delete('area');
      window.history.pushState({}, '', url);
    }

    function setActiveType(value: string) {
      activeType = value;
      for (const btn of typeButtons) {
        const pressed = btn.value === value;
        btn.setAttribute('aria-pressed', String(pressed));
        btn.classList.toggle('border-ink', pressed);
        btn.classList.toggle('bg-ink', pressed);
        btn.classList.toggle('text-paper', pressed);
        btn.classList.toggle('border-rule', !pressed);
        btn.classList.toggle('bg-transparent', !pressed);
        btn.classList.toggle('text-ink-soft', !pressed);
      }
    }

    for (const button of typeButtons) {
      button.addEventListener('click', (event) => {
        event.preventDefault();
        setActiveType(button.value);
        applyFilters();
        updateUrl();
      });
    }

    daySelect?.addEventListener('change', () => {
      activeDay = daySelect.value;
      applyFilters();
      updateUrl();
    });

    areaSelect?.addEventListener('change', () => {
      activeArea = areaSelect.value;
      applyFilters();
      updateUrl();
    });

    const clearFilters = document.getElementById('clear-filters');
    clearFilters?.addEventListener('click', (event) => {
      event.preventDefault();
      setActiveType('');
      activeDay = '';
      if (daySelect) daySelect.value = '';
      activeArea = '';
      if (areaSelect) areaSelect.value = '';
      applyFilters();
      updateUrl();
    });

    if (applyButton) applyButton.hidden = true;
    applyFilters();
  }
</script>
