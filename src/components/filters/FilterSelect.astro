---
interface Option {
  value: string;
  label: string;
}

interface Props {
  name: string;
  id: string;
  ariaLabel: string;
  options: Option[];
  value: string | null;
}

const { name, id, ariaLabel, options, value } = Astro.props;
---

<div class="relative">
  <select
    name={name}
    id={id}
    aria-label={ariaLabel}
    class="appearance-none rounded-sm border border-rule bg-paper py-1.75 pr-7 pl-2.5 font-body text-[0.92rem] text-ink"
  >
    {
      options.map((option) => (
        <option value={option.value} selected={(value ?? '') === option.value}>
          {option.label}
        </option>
      ))
    }
  </select>
  <svg
    class="pointer-events-none absolute top-1/2 right-2.5 h-3 w-3 -translate-y-1/2 text-ink-soft"
    viewBox="0 0 12 12"
    fill="none"
    aria-hidden="true"
  >
    <path
      d="M3 4.5L6 7.5L9 4.5"
      stroke="currentColor"
      stroke-width="1.3"
      stroke-linecap="round"
      stroke-linejoin="round"
    />
  </svg>
</div>
