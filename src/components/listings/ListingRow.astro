---
import TicketStub from "./TicketStub.astro";
import { formatStubDate, formatTime } from "../../lib/utils/format";

export interface ListingRowData {
  id: string;
  title: string;
  type: "mic" | "show";
  dayOfWeek: number;
  areaId: string;
  venueName: string;
  host?: string | null;
  signUpMethod?: string | null;
  costToPerform?: string | null;
  ticketPrice?: string | null;
  ticketUrl?: string | null;
  date: string;
  startTime: string;
  note?: string;
  isSoon: boolean;
  hidden: boolean;
  isLastVisible?: boolean;
}

const {
  id,
  title,
  type,
  dayOfWeek,
  areaId,
  venueName,
  host,
  signUpMethod,
  costToPerform,
  ticketPrice,
  ticketUrl,
  date,
  startTime,
  note,
  isSoon,
  hidden,
  isLastVisible = false,
} = Astro.props as ListingRowData;

const stub = formatStubDate(date);
const timeLabel = formatTime(startTime);
const priceAmount = type === "mic" ? costToPerform : ticketPrice;
---

<li
  class:list={[
    "row grid gap-x-4.5 border-rule py-5.5 max-[600px]:gap-y-1.5",
    !isLastVisible && "border-b",
  ]}
  data-listing-row
  data-type={type}
  data-day={dayOfWeek}
  data-area={areaId}
  hidden={hidden}
>
  <TicketStub
    day={stub.day}
    date={stub.date}
    month={stub.month}
    isSoon={isSoon}
    class="[grid-area:stub]"
  />

  <div
    class="[grid-area:time] pt-0.5 font-mono text-[0.92rem] text-ink-soft tabular-nums max-[600px]:pt-0"
  >
    {timeLabel}
  </div>

  <div class="[grid-area:title] min-w-0">
    <div class="flex flex-wrap items-baseline gap-2.5">
      <h2 class="text-balance font-display text-[1.28rem] font-bold">
        <a href={`/listings/${id}`} class="underline-offset-2 hover:underline"
          >{title}</a
        >
      </h2>
      <span
        class="rounded-sm border border-rule px-1.5 py-px font-body text-[0.65rem] font-semibold tracking-wider text-ink-soft uppercase whitespace-nowrap"
      >
        {type === "mic" ? "Mic" : "Show"}
      </span>
    </div>
    <p class="mt-1 text-[0.94rem]">{venueName}</p>
    {
      host && (
        <p class="mt-0.75 text-[0.86rem] text-ink-soft">Hosted by {host}</p>
      )
    }
    {
      type === "mic" && signUpMethod && (
        <p class="mt-0.75 text-[0.86rem] font-medium text-ink">
          Sign-up: {signUpMethod}
        </p>
      )
    }
    {note && <p class="mt-0.75 text-[0.86rem] text-ink-soft">{note}</p>}
    {
      isSoon && (
        <span class="mt-1.5 inline-flex items-center gap-1.5 text-[0.78rem] font-medium text-gold-ink before:h-1.75 before:w-1.75 before:flex-none before:rounded-full before:bg-gold">
          This week
        </span>
      )
    }
  </div>

  <div class="[grid-area:price] pt-0.5 text-right whitespace-nowrap">
    {
      priceAmount && (
        <span class="block text-[0.95rem] font-semibold capitalize">
          {priceAmount}
        </span>
      )
    }
    {
      type === "show" && ticketUrl && (
        <a
          href={ticketUrl}
          target="_blank"
          rel="noopener"
          class="mt-1 inline-block text-[0.86rem] underline underline-offset-2"
        >
          Buy tickets
        </a>
      )
    }
  </div>
</li>

<style>
  .row {
    grid-template-columns: 60px 78px 1fr auto;
    grid-template-areas: "stub time title price";
  }

  .row[hidden] {
    display: none;
  }

  @media (max-width: 600px) {
    .row {
      grid-template-columns: 52px 1fr 78px;
      grid-template-areas:
        "stub title price"
        "stub time  time";
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .row {
      transition: opacity 0.15s ease;
    }
  }
</style>
