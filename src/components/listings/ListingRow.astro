---
import TicketStub from "./TicketStub.astro";
import { formatStubDate, formatTime } from "../../lib/utils/format";
import { SIGN_UP_METHOD_LABEL } from "../../lib/utils/moderation-labels";

export interface ListingRowData {
  id: string;
  title: string;
  type: "mic" | "show";
  dayOfWeek: number;
  areaIds: string[];
  venueName: string;
  host?: string | null;
  signUpMethod?: string | null;
  signUpUrl?: string | null;
  costToPerform?: string | null;
  ticketPrice?: string | null;
  ticketUrl?: string | null;
  date: string;
  startTime: string;
  note?: string;
  isSoon: boolean;
  hidden: boolean;
  isLastVisible?: boolean;
}

const {
  id,
  title,
  type,
  dayOfWeek,
  areaIds,
  venueName,
  host,
  signUpMethod,
  signUpUrl,
  costToPerform,
  ticketPrice,
  ticketUrl,
  date,
  startTime,
  note,
  isSoon,
  hidden,
  isLastVisible = false,
} = Astro.props as ListingRowData;

const stub = formatStubDate(date);
const timeLabel = formatTime(startTime);
const priceAmount = type === "mic" ? costToPerform : ticketPrice;
---

<li
  class:list={[
    "row border-rule grid gap-x-4.5 py-5.5 max-[600px]:gap-y-1.5",
    !isLastVisible && "border-b",
  ]}
  data-listing-row
  data-type={type}
  data-day={dayOfWeek}
  data-area={areaIds.join(" ")}
  hidden={hidden}
>
  <TicketStub
    day={stub.day}
    date={stub.date}
    month={stub.month}
    isSoon={isSoon}
    class="[grid-area:stub]"
  />

  <div
    class="text-ink-soft pt-0.5 font-mono text-[0.92rem] tabular-nums [grid-area:time] max-[600px]:pt-0"
  >
    {timeLabel}
  </div>

  <div class="min-w-0 [grid-area:title]">
    <div class="flex flex-wrap items-baseline gap-2.5">
      <h2 class="font-display text-[1.28rem] font-bold text-balance">
        <a href={`/listings/${id}`} class="underline-offset-2 hover:underline"
          >{title}</a
        >
      </h2>
      <span
        class="border-rule font-body text-ink-soft rounded-sm border px-1.5 py-px text-[0.65rem] font-semibold tracking-wider whitespace-nowrap uppercase"
      >
        {type === "mic" ? "Mic" : "Show"}
      </span>
    </div>
    <p class="mt-1 text-[0.94rem]">{venueName}</p>
    {
      host && (
        <p class="text-ink-soft mt-0.75 text-[0.86rem]">Hosted by {host}</p>
      )
    }
    {
      type === "mic" && signUpMethod && (
        <p class="text-ink mt-0.75 text-[0.86rem] font-medium">
          Sign-up:{" "}
          {signUpMethod === "slotted_online" && signUpUrl ? (
            <a
              href={signUpUrl}
              target="_blank"
              rel="noopener"
              class="underline underline-offset-2"
            >
              {SIGN_UP_METHOD_LABEL[signUpMethod]}
            </a>
          ) : (
            SIGN_UP_METHOD_LABEL[signUpMethod]
          )}
        </p>
      )
    }
    {note && <p class="text-ink-soft mt-0.75 text-[0.86rem]">{note}</p>}
    {
      isSoon && (
        <span class="text-gold-ink before:bg-gold mt-1.5 inline-flex items-center gap-1.5 text-[0.78rem] font-medium before:h-1.75 before:w-1.75 before:flex-none before:rounded-full">
          This week
        </span>
      )
    }
  </div>

  <div class="pt-0.5 text-right whitespace-nowrap [grid-area:price]">
    {
      priceAmount && (
        <span class="block text-[0.95rem] font-semibold capitalize">
          {priceAmount}
        </span>
      )
    }
    {
      type === "show" && ticketUrl && (
        <a
          href={ticketUrl}
          target="_blank"
          rel="noopener"
          class="mt-1 inline-block text-[0.86rem] underline underline-offset-2"
        >
          Buy tickets
        </a>
      )
    }
  </div>
</li>

<style>
  .row {
    grid-template-columns: 60px 78px 1fr auto;
    grid-template-areas: "stub time title price";
  }

  .row[hidden] {
    display: none;
  }

  @media (max-width: 600px) {
    .row {
      grid-template-columns: 52px 1fr 78px;
      grid-template-areas:
        "stub title price"
        "stub time  time";
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .row {
      transition: opacity 0.15s ease;
    }
  }
</style>
