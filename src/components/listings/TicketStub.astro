---
interface Props {
  day: string;
  date: string;
  month: string;
  isSoon: boolean;
  size?: 'default' | 'large';
  class?: string;
}

const {
  day,
  date,
  month,
  isSoon,
  size = 'default',
  class: className = '',
} = Astro.props;

const large = size === 'large';

const edgeColor = isSoon
  ? 'border-l-[color-mix(in_srgb,var(--gold)_60%,var(--paper)_40%)]'
  : 'border-l-rule';
---

<div
  class:list={[
    'stub flex flex-col items-center justify-center rounded-sm bg-paper-shadow text-center',
    edgeColor,
    large ? 'border-l-4 px-2 py-3' : 'border-l-[3px] px-0.5 py-1.5',
    className,
  ]}
>
  <span
    class:list={[
      'font-body font-semibold tracking-wider text-ink-soft uppercase',
      large ? 'text-[0.78rem]' : 'text-[0.68rem]',
    ]}>{day}</span
  >
  <span
    class:list={[
      'font-mono leading-tight font-semibold tabular-nums',
      large ? 'text-[2.1rem]' : 'text-[1.15rem]',
    ]}>{date}</span
  >
  <span
    class:list={[
      'font-body font-semibold tracking-wider text-ink-soft uppercase',
      large ? 'text-[0.72rem]' : 'text-[0.62rem]',
    ]}>{month}</span
  >
</div>
