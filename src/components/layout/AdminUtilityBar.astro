---
interface Props {
  backHref?: string;
  backLabel?: string;
}

const { backHref, backLabel = "Back to queue" } = Astro.props;
---

<div
  class:list={[
    "flex items-center gap-4 pt-6 text-[0.86rem]",
    backHref ? "justify-between" : "justify-end",
  ]}
>
  {
    backHref && (
      <a
        href={backHref}
        class="text-ink-soft inline-flex items-center gap-1.5 underline-offset-2 hover:underline"
      >
        <svg class="h-2.5 w-2.5 rotate-90" viewBox="0 0 12 12" fill="none">
          <path
            d="M3 4.5L6 7.5L9 4.5"
            stroke="currentColor"
            stroke-width="1.3"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
        </svg>
        {backLabel}
      </a>
    )
  }
  <a
    href="/"
    target="_blank"
    rel="noopener"
    class="text-ink-soft underline-offset-2 hover:underline"
  >
    View live site ↗
  </a>
</div>
