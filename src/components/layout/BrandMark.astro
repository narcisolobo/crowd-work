---
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<svg class={className} viewBox="0 0 24 24" fill="none" aria-hidden="true">
  <rect x="9" y="2" width="6" height="11" rx="3" fill="currentColor" />
  <path
    d="M6 11a6 6 0 0 0 12 0"
    stroke="currentColor"
    stroke-width="1.6"
    stroke-linecap="round"
  />
  <line
    x1="12"
    y1="17"
    x2="12"
    y2="21"
    stroke="currentColor"
    stroke-width="1.6"
    stroke-linecap="round"
  />
  <line
    x1="8"
    y1="21"
    x2="16"
    y2="21"
    stroke="currentColor"
    stroke-width="1.6"
    stroke-linecap="round"
  />
  <circle cx="16.5" cy="4.5" r="2.2" fill="var(--gold)" />
</svg>
