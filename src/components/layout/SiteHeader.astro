---
import BrandMark from "./BrandMark.astro";
import ThemeToggle from "../theme/ThemeToggle.astro";
---

<header class="site-nav bg-paper-shadow sticky top-0 z-20">
  <div
    class="bg-paper mx-auto flex h-14 max-w-180 items-center gap-5.5 border-b border-b-[color-mix(in_srgb,var(--ink)_25%,var(--paper)_75%)] px-5"
  >
    <a href="/" class="text-ink mr-auto flex items-center gap-2 no-underline">
      <BrandMark class="text-ink h-5.75 w-5.75 flex-none" />
      <span class="font-display text-[1.15rem] font-bold tracking-tight"
        >Crowd Work</span
      >
    </a>
    <nav class="flex items-center gap-4.5" aria-label="Primary">
      <a
        href="/"
        class="font-body text-ink-soft hover:text-ink text-[0.9rem] underline-offset-2 hover:underline max-[480px]:hidden"
        >Browse</a
      >
      <a
        href="/listings/new"
        class="font-body text-ink-soft hover:text-ink text-[0.9rem] underline-offset-2 hover:underline"
      >
        <span class="max-[480px]:hidden">Submit a listing</span>
        <span class="hidden max-[480px]:inline">Submit</span>
      </a>
    </nav>
    <ThemeToggle />
  </div>
</header>
